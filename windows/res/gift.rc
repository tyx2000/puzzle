#include <windows.h>

1 ICON "Gift.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gift.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gift"
            VALUE "FileDescription", "Gift - a minimal native Git client"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Gift"
            VALUE "OriginalFilename", "Gift.exe"
            VALUE "ProductName", "Gift"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
