#include <windows.h>

1 ICON "Puzzle.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "puzzle.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Puzzle"
            VALUE "FileDescription", "Puzzle - a minimal native code editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Puzzle"
            VALUE "OriginalFilename", "Puzzle.exe"
            VALUE "ProductName", "Puzzle"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
